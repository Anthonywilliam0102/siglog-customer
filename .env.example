# Copie para .env (NUNCA versione o .env). Valores abaixo são apenas de desenvolvimento local.
APP_ENV=local
APP_PORT=8000
SERVICE_NAME=siglog-customer

# Banco local (container). Para Supabase use a connection string do projeto no .env ou em GitHub Secrets.
POSTGRES_USER=siglog
POSTGRES_PASSWORD=siglog_dev
POSTGRES_DB=siglog_customer
DATABASE_URL=postgresql+psycopg://siglog:siglog_dev@postgres:5432/siglog_customer

# Mensageria
RABBITMQ_USER=siglog
RABBITMQ_PASSWORD=siglog_dev
RABBITMQ_URL=amqp://siglog:siglog_dev@rabbitmq:5672/

# Observabilidade
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
WORKER_METRICS_PORT=9100
GRAFANA_ADMIN_PASSWORD=admin_dev

# Autenticação (JWT HS256 — compatível com o JWT secret do Supabase Auth)
JWT_SECRET=troque-este-segredo-de-desenvolvimento-32chars
# Rastreamento (contrato do squad Tracking) — vazio = indisponível
TRACKING_BASE_URL=
# Demo: rastreamento simulado enquanto o contrato do squad Tracking não existe (true/false)
TRACKING_MOCK=true
# Origens do front em produção, separadas por vírgula (em dev o Vite usa proxy e não precisa)
CORS_ORIGINS=

# --- Supabase (opcional; ver docs/15_supabase.md) ---
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_URL=https://<ref>.supabase.co
