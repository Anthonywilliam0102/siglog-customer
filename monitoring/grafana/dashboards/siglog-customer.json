{
  "uid": "siglog-customer",
  "title": "SIG-Log Customer",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Operacional (comum a todos os módulos)",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "Requests/min",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(requests_total[1m])) * 60",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Latência p95",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(request_duration_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Taxa de erros (5xx)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(errors_total[5m])) / clamp_min(sum(rate(requests_total[5m])), 1)",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Disponibilidade",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "expr": "avg_over_time(up{job=\"siglog-customer\"}[5m])",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Mensagens processadas",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(messages_processed_total[5m])) * 60",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Requisições ativas",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "active_requests",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Domínio: clientes, tickets, sinistros, SLA, satisfação",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 9,
      "title": "Clientes",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "expr": "siglog_customers",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Tickets por status",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 6,
        "y": 16,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "expr": "siglog_tickets",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Tickets com SLA vencido",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "expr": "siglog_tickets_sla_breached",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Sinistros por status",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "expr": "siglog_claims",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Satisfação média (1–5)",
      "type": "gauge",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "siglog_satisfaction_avg",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Total de avaliações",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "siglog_feedback_total",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ],
  "tags": [
    "siglog"
  ]
}